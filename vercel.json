{
  "framework": null,
  "functions": {
    "api/generate.js": {
      "maxDuration": 300
    },
    "api/okeii.js": {
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/billing",
      "destination": "/ai-solves-billing",
      "permanent": true
    },
    {
      "source": "/billing/",
      "destination": "/ai-solves-billing/",
      "permanent": true
    },
    {
      "source": "/am-1998",
      "destination": "/90s-web-ackerman-mcqueen",
      "permanent": true
    },
    {
      "source": "/am-1998/",
      "destination": "/90s-web-ackerman-mcqueen/",
      "permanent": true
    },
    {
      "source": "/am-1998/:path+",
      "destination": "/90s-web-ackerman-mcqueen/:path+",
      "permanent": true
    },
    {
      "source": "/arcade",
      "destination": "/vault",
      "permanent": true
    },
    {
      "source": "/arcade/",
      "destination": "/vault/",
      "permanent": true
    },
    {
      "source": "/arcade/:path+",
      "destination": "/vault/:path+",
      "permanent": true
    },
    {
      "source": "/second-brain",
      "destination": "https://brain-site-tan.vercel.app/",
      "permanent": false
    },
    {
      "source": "/second-brain/",
      "destination": "https://brain-site-tan.vercel.app/",
      "permanent": false
    },
    {
      "source": "/mind-harvest",
      "destination": "https://x-expert-poster.vercel.app/",
      "permanent": false
    },
    {
      "source": "/mind-harvest/",
      "destination": "https://x-expert-poster.vercel.app/",
      "permanent": false
    },
    {
      "source": "/ai-second-brain-case-study",
      "destination": "/second-brain-case-study",
      "permanent": true
    },
    {
      "source": "/ai-second-brain-case-study/",
      "destination": "/second-brain-case-study/",
      "permanent": true
    },
    {
      "source": "/ai-second-brain-case-study/:path+",
      "destination": "/second-brain-case-study/:path+",
      "permanent": true
    },
    {
      "source": "/okeii",
      "destination": "/OKEII-SRA-Deployment/",
      "permanent": false
    },
    {
      "source": "/okeii/",
      "destination": "/OKEII-SRA-Deployment/",
      "permanent": false
    },
    {
      "source": "/okeii-sra-deployment",
      "destination": "/OKEII-SRA-Deployment/",
      "permanent": false
    },
    {
      "source": "/okeii-sra-deployment/",
      "destination": "/OKEII-SRA-Deployment/",
      "permanent": false
    },
    {
      "source": "/okeii-sra-deployment/:path+",
      "destination": "/OKEII-SRA-Deployment/:path+",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/widget-maker/w/:id",
      "destination": "/api/widget?id=:id"
    }
  ],
  "headers": [
    {
      "source": "/vault/media/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/OKEII-SRA-Deployment",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/OKEII-SRA-Deployment/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/OKEII-SRA-Deployment/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/OKEII-SRA-Deployment/build.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ]
}

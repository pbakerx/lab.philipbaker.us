{
  "framework": null,
  "functions": {
    "api/generate.js": {
      "maxDuration": 300
    }
  },
  "redirects": [
    { "source": "/billing", "destination": "/ai-solves-billing", "permanent": true },
    { "source": "/billing/", "destination": "/ai-solves-billing/", "permanent": true },
    { "source": "/am-1998", "destination": "/90s-web-ackerman-mcqueen", "permanent": true },
    { "source": "/am-1998/", "destination": "/90s-web-ackerman-mcqueen/", "permanent": true },
    { "source": "/am-1998/:path+", "destination": "/90s-web-ackerman-mcqueen/:path+", "permanent": true },
    { "source": "/arcade", "destination": "/vault", "permanent": true },
    { "source": "/arcade/", "destination": "/vault/", "permanent": true },
    { "source": "/arcade/:path+", "destination": "/vault/:path+", "permanent": true },
    { "source": "/ai-second-brain-case-study", "destination": "/second-brain", "permanent": true },
    { "source": "/ai-second-brain-case-study/:path*", "destination": "/second-brain/:path*", "permanent": true }
  ],
  "headers": [
    {
      "source": "/vault/media/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
